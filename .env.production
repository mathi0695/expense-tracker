# Production Environment Configuration
# Copy this file to .env for production deployment

# MongoDB Configuration (use MongoDB Atlas or external MongoDB)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/expense-tracker?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=CHANGE_THIS_TO_A_STRONG_RANDOM_STRING_IN_PRODUCTION

# AI Configuration
AI_PROVIDER=openai

# OpenAI Configuration
OPENAI_API_KEY=your-production-openai-api-key

# Google Gemini Configuration (if using Gemini)
GEMINI_API_KEY=your-production-gemini-api-key

# AI Model
AI_MODEL=gpt-4

# CORS Configuration (set to your frontend domain)
CORS_ORIGIN=https://yourdomain.com

# Frontend API URL (set to your backend domain)
VITE_API_URL=https://api.yourdomain.com/api

